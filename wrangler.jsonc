{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chic-interiors",
  "main": "worker.py",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": [
    "python_workers"
  ],
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "observability": {
    "enabled": true
  }
}
